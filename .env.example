# Model Provider Configuration (OpenAI, OpenRouter, or OpenAI-compatible)
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
# Optional custom base URL (e.g., https://openrouter.ai/api/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1
# Model choice: gpt-4o-mini, gpt-4o, claude-3-5-haiku-20241022, etc.
MODEL_NAME=gpt-4o-mini

# Web Search Provider (Tavily)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Server & Storage Configuration
PORT=3000
DB_PATH=data/chat.db

